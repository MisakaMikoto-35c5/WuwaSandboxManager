<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wsm.Localization</RootNamespace>
    <AssemblyName>Wsm.Localization</AssemblyName>
    <Description>ABP localization resource for non-UI text (JSON resources, en / zh-Hans).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\00-Core\Wsm.Domain\Wsm.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Core" />
    <PackageReference Include="Volo.Abp.Localization" />
    <PackageReference Include="Volo.Abp.VirtualFileSystem" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

</Project>
