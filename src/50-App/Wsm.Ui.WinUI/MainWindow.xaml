<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wsm.Ui.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Wsm.Ui.WinUI.ViewModels"
    xmlns:vo="using:Wsm.Domain.ValueObjects">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Border Grid.Row="0"
                Padding="20,14,20,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource WsmAccentBrush}">
                        <TextBlock Text="WS"
                                   Foreground="White"
                                   FontFamily="{StaticResource WsmMonoFont}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Uid="AppTitle"
                                   Text="Windows Sandbox Manager"
                                   FontFamily="{StaticResource WsmDisplayFont}"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="AppSubtitle"
                                   Text="Multi-engine sandbox control"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Uid="NewButton"
                            Content="New sandbox"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnNewSandboxClick" />
                    <Button x:Uid="OpenButton" Content="Open" Click="OnOpenFileClick" />
                    <Button x:Uid="RefreshButton" Content="Refresh" Command="{Binding RefreshCommand}" />
                    <Button x:Name="AppSettingsButton" Click="OnAppSettingsClick">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <ToolTipService.ToolTip>
                            <ToolTip x:Uid="SettingsButton" Content="Settings" />
                        </ToolTipService.ToolTip>
                    </Button>
                    <ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================= Body ============================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Instance list -->
            <Grid Grid.Column="0" Padding="16,14,8,14" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="InstancesSection"
                               Text="Instances"
                               Style="{StaticResource SectionTitle}"
                               Margin="0" />
                    <Border Style="{StaticResource PillBorder}" Background="{StaticResource WsmAccentSoftBrush}">
                        <TextBlock Text="{Binding Instances.Count}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WsmAccentBrush}" />
                    </Border>
                </StackPanel>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SandboxInstanceViewModel">
                            <Grid Padding="2,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{x:Bind StateBrush, Mode=OneWay}"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind TypeLabel, Mode=OneWay}"
                                               Style="{StaticResource MetaText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind ShortId}"
                                           FontFamily="{StaticResource WsmMonoFont}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1"
                           x:Uid="InstanceListEmpty"
                           Text="No instances yet. Create one to get started."
                           Margin="8"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasInstances, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            </Grid>

            <!-- Detail -->
            <Grid Grid.Column="1" Padding="8,14,16,14">
                <TextBlock x:Uid="EmptySelection"
                           Text="Select an instance, or create a new sandbox."
                           Margin="40"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="14" Padding="0,0,4,0">
                        <!-- Identity + state -->
                        <Border Style="{StaticResource SectionCard}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Selected.Name}"
                                               FontFamily="{StaticResource WsmDisplayFont}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource PillBorder}" Background="{StaticResource WsmAccentSoftBrush}">
                                            <TextBlock Text="{Binding Selected.TypeLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource WsmAccentBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Selected.ShortId}"
                                                   FontFamily="{StaticResource WsmMonoFont}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                    <Ellipse Width="9" Height="9" Fill="{Binding Selected.StateBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Selected.StateLabel}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Primary lifecycle actions -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding Selected.PrimaryActionLabel}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    MinWidth="120"
                                    Command="{Binding Selected.PrimaryActionCommand}"
                                    IsEnabled="{Binding Selected.IsPrimaryEnabled}" />
                            <Button x:Uid="DisconnectButton"
                                    Content="Disconnect"
                                    Command="{Binding Selected.DisconnectCommand}"
                                    Visibility="{Binding Selected.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <Button x:Uid="StopButton"
                                    Content="Stop"
                                    Command="{Binding Selected.StopCommand}"
                                    Visibility="{Binding Selected.ShowStop, Converter={StaticResource BoolToVisibility}}" />
                            <Button x:Uid="SandboxSettingsButton"
                                    Content="Sandbox settings"
                                    Click="OnInstanceSettingsClick" />
                        </StackPanel>

                        <!-- Quick launch (RAIL): the WDAG guest is RemoteApp-only, so
                             a program is what actually appears on screen. RAIL sessions
                             are presented by mstsc with a generated .rdp document. -->
                        <Border Style="{StaticResource SectionCard}"
                                Visibility="{Binding Selected.RailMode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="QuickLaunchSection" Text="Quick launch" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Uid="QuickLaunchCaption"
                                           Text="Open a program as a RemoteApp window."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <ItemsControl ItemsSource="{Binding Selected.QuickLaunchPrograms}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QuickLaunchProgram">
                                            <Button Command="{Binding DataContext.Selected.LaunchProgramCommand, ElementName=Root}"
                                                    CommandParameter="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                                                    <TextBlock Text="{x:Bind DisplayName}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Uid="AddAppButton"
                                            Content="Add application..."
                                            Click="OnAddGlobalAppClick" />
                                    <Button x:Uid="CreateShortcutButton"
                                            Content="Create shortcut..."
                                            Click="OnCreateShortcutClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- At a glance -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="SummaryMemory" Text="Memory (MB)" Style="{StaticResource MetaText}" />
                                        <TextBlock Text="{Binding Selected.MemoryMb}" FontSize="14" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock x:Uid="SummaryCpu" Text="CPU cores" Style="{StaticResource MetaText}" />
                                        <TextBlock Text="{Binding Selected.CpuCores}" FontSize="14" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Uid="SummaryLocation" Text="Data location" Style="{StaticResource MetaText}" />
                                    <TextBlock Text="{Binding Selected.SandboxFolder}"
                                               FontFamily="{StaticResource WsmMonoFont}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Uid="SummaryEngine" Text="Engine" Style="{StaticResource MetaText}" />
                                    <TextBlock Text="{Binding Selected.EngineLabel}" FontSize="14" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Selected.Status}"
                                   Margin="4,0,4,8"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================ Status bar ============================ -->
        <Border Grid.Row="2"
                Padding="20,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="3" CornerRadius="2" Background="{StaticResource WsmAccentBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Status}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ======================= App settings dialog ======================= -->
        <ContentDialog x:Name="AppSettingsDialog"
                       x:Uid="AppSettingsDialog"
                       Title="Settings"
                       CloseButtonText="Close"
                       DefaultButton="Close">
            <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Width="420">
                    <!-- Language -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="LanguageLabel"
                                   Text="Language"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="LanguageCombo"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  SelectionChanged="OnLanguageChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LanguageOption">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- RDP connector -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="RdpConnectorLabel"
                                   Text="RDP connector"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="RdpConnectorCombo"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding RdpConnectors}"
                                  SelectedItem="{Binding SelectedRdpConnector, Mode=TwoWay}"
                                  SelectionChanged="OnRdpConnectorChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RdpConnectorOption">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Uid="RdpConnectorHint"
                                   Text="Which presentation shows RDP sessions: the WPF window, or the WinUI 3 connector (its own process). Changing it restarts the app."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- Config & data folder -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="ConfigDataFolderLabel"
                                   Text="Config &amp; data folder"
                                   Style="{StaticResource FieldLabel}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ConfigDataFolder, Mode=OneWay}"
                                     IsReadOnly="True" />
                            <Button Grid.Column="1"
                                    x:Uid="BrowseButton"
                                    Content="Browse"
                                    Click="OnBrowseConfigDataFolder" />
                        </Grid>
                        <TextBlock x:Uid="ConfigDataFolderHint"
                                   Text="One subfolder per sandbox; each holds its manifest, recipe and data. Changing it restarts the app."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- Routing engine -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="EnginesSection"
                                   Text="Engine"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Uid="EnginesCaption"
                                   Text="HCS when elevated, otherwise Windows Sandbox."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Engines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EngineOptionViewModel">
                                    <RadioButton GroupName="EngineGroup"
                                                 Margin="0,2"
                                                 IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                 IsEnabled="{x:Bind IsAvailable}">
                                        <RadioButton.Content>
                                            <Grid ColumnSpacing="10" Padding="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind ShortSummary}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource PillBorder}"
                                                        VerticalAlignment="Top"
                                                        Background="{x:Bind StatusBackgroundBrush}">
                                                    <TextBlock Text="{x:Bind StatusLabel}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{x:Bind StatusBrush}" />
                                                </Border>
                                            </Grid>
                                        </RadioButton.Content>
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="{x:Bind CapabilityTooltip}" />
                                        </ToolTipService.ToolTip>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Process-isolation image (Windows Server) -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="ContainerImageSection"
                                   Text="Process isolation image"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Uid="ContainerImageCaption"
                                   Text="Process isolation (HCS container) needs an image; download a Windows Server image to enable it."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding ContainerIsolationStatus}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ContainerImageReferences}"
                                  SelectedItem="{Binding SelectedContainerImageReference, Mode=TwoWay}"
                                  IsEnabled="{Binding CanDownloadContainerImage}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ContainerImageFolder, Mode=TwoWay}"
                                     IsEnabled="{Binding CanDownloadContainerImage}" />
                            <Button Grid.Column="1"
                                    x:Uid="BrowseButton"
                                    Content="Browse"
                                    Click="OnBrowseContainerImageFolder"
                                    IsEnabled="{Binding CanDownloadContainerImage}" />
                        </Grid>
                        <Button x:Uid="ContainerImageDownloadButton"
                                Content="Download image"
                                HorizontalAlignment="Left"
                                Command="{Binding DownloadContainerImageCommand}" />
                        <ProgressBar Maximum="100"
                                     Value="{Binding ContainerImageProgress, Mode=OneWay}"
                                     Visibility="{Binding IsContainerImageDownloading, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ContainerImageProgressText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Uid="ContainerImageElevationHint"
                                   Text="Downloading requires an elevated app (restart elevated first)."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    </StackPanel>

                    <!-- Environment / about -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="EnvironmentSection"
                                   Text="Environment"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding EnvironmentSummary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Uid="ElevateButton"
                                Content="Restart elevated"
                                HorizontalAlignment="Left"
                                Click="OnElevateClick"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <!-- ======================= Create dialog ======================= -->
        <ContentDialog x:Name="CreateDialog"
                       x:Uid="CreateDialog"
                       Title="New sandbox"
                       PrimaryButtonText="Create"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="OnCreateDialogPrimary">
            <StackPanel Spacing="14" Width="420">
                <TextBox x:Uid="CreateNameBox"
                         Header="Name"
                         PlaceholderText="My sandbox"
                         Text="{Binding NewName, Mode=TwoWay}" />

                <StackPanel Spacing="6">
                    <TextBlock x:Uid="CreateTypeHeader" Text="Type" Style="{StaticResource FieldLabel}" />
                    <RadioButtons SelectedIndex="{Binding NewTypeIndex, Mode=TwoWay}">
                        <RadioButton x:Uid="CreateTypeRemoteApp" Content="RemoteApp (RAIL)" />
                        <RadioButton x:Uid="CreateTypeDesktop" Content="Full desktop" />
                    </RadioButtons>
                </StackPanel>

                <StackPanel Spacing="4"
                            Visibility="{Binding IsNewRailMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBox x:Uid="CreateRailProgramBox"
                             Header="Default RAIL program"
                             PlaceholderText="C:\Windows\explorer.exe"
                             Text="{Binding NewRailProgram, Mode=TwoWay}" />
                    <TextBlock x:Uid="RailProgramHint"
                               Text="The program a RAIL session launches. The WDAG guest has no desktop, so this is what appears."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock x:Uid="CreateEngineHeader" Text="Engine" Style="{StaticResource FieldLabel}" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding NewEngineOptions}"
                              SelectedItem="{Binding NewEngineOption, Mode=TwoWay}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EngineSelectOption">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Expander x:Uid="CreateResourcesExpander" Header="Resources">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Uid="CreateMemoryBox"
                                   Header="Memory (MB)"
                                   Value="{Binding NewMemoryMb, Mode=TwoWay}"
                                   Minimum="2048"
                                   Maximum="262144"
                                   SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="1"
                                   x:Uid="CreateCpuBox"
                                   Header="CPU cores"
                                   Value="{Binding NewCpuCores, Mode=TwoWay}"
                                   Minimum="1"
                                   Maximum="64"
                                   SpinButtonPlacementMode="Compact" />
                    </Grid>
                </Expander>
            </StackPanel>
        </ContentDialog>

        <!-- ======================= Instance settings dialog ======================= -->
        <ContentDialog x:Name="InstanceSettingsDialog"
                       x:Uid="InstanceSettingsDialog"
                       Title="Sandbox settings"
                       PrimaryButtonText="Save"
                       CloseButtonText="Close"
                       DefaultButton="Primary"
                       PrimaryButtonClick="OnSaveInstanceSettings">
            <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Width="460">
                    <!-- Identity -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="IdentitySection" Text="Identity" Style="{StaticResource SectionTitle}" />
                            <TextBox x:Uid="NameBox" Header="Name" Text="{Binding Selected.Name, Mode=TwoWay}" />
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="EngineLabelHeader" Text="Engine" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Selected.EngineLabel}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Uid="ConfigCaption"
                                       Text="Saving re-creates this definition."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Resources -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="ResourcesSection" Text="Resources" Style="{StaticResource SectionTitle}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Uid="MemoryBox"
                                           Header="Memory (MB)"
                                           Value="{Binding Selected.MemoryMb, Mode=TwoWay}"
                                           Minimum="2048"
                                           Maximum="262144"
                                           SpinButtonPlacementMode="Compact" />
                                <NumberBox Grid.Column="1"
                                           x:Uid="CpuBox"
                                           Header="CPU cores"
                                           Value="{Binding Selected.CpuCores, Mode=TwoWay}"
                                           Minimum="1"
                                           Maximum="64"
                                           SpinButtonPlacementMode="Compact" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Uid="NetworkingBox"
                                          Header="Networking"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Selected.NetworkingOptions}"
                                          SelectedItem="{Binding Selected.SelectedNetworking, Mode=TwoWay}" />
                                <ComboBox Grid.Column="1"
                                          x:Uid="VgpuBox"
                                          Header="Virtual GPU"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Selected.VgpuOptions}"
                                          SelectedItem="{Binding Selected.SelectedVgpu, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Session -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="SessionSection" Text="Session" Style="{StaticResource SectionTitle}" />
                            <StackPanel Spacing="4">
                                <ComboBox x:Uid="TransportBox"
                                          Header="RDP transport"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Selected.TransportOptions}"
                                          SelectedItem="{Binding Selected.SelectedTransport, Mode=TwoWay}" />
                                <TextBlock x:Uid="TransportHint"
                                           Text="Named pipe is fastest but allows a single session host-wide; use TCP to connect multiple sandboxes at once. TCP requires Networking enabled."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Uid="RailSwitch" Header="RemoteApp (RAIL) mode" IsOn="{Binding Selected.RailMode, Mode=TwoWay}" />
                            <StackPanel Spacing="4"
                                        Visibility="{Binding Selected.RailMode, Converter={StaticResource BoolToVisibility}}">
                                <TextBox x:Uid="RailProgramBox"
                                         Header="Default RAIL program"
                                         PlaceholderText="C:\Windows\explorer.exe"
                                         Text="{Binding Selected.RailProgram, Mode=TwoWay}" />
                                <TextBlock x:Uid="RailProgramHint"
                                           Text="The program a RAIL session launches. The WDAG guest has no desktop, so this is what appears."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Uid="FullScreenSwitch" Header="Full screen" IsOn="{Binding Selected.FullScreen, Mode=TwoWay}" />
                            <ToggleSwitch x:Uid="ProtectedSwitch" Header="Protected client" IsOn="{Binding Selected.ProtectedClient, Mode=TwoWay}" />
                            <ToggleSwitch x:Uid="RebootSwitch" Header="Allow guest reboot" IsOn="{Binding Selected.RebootSupport, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Storage -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="StorageSection" Text="Storage" Style="{StaticResource SectionTitle}" />
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="SandboxFolderLabel" Text="Folder" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Selected.SandboxFolder}"
                                           FontFamily="{StaticResource WsmMonoFont}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <NumberBox x:Uid="DiskSizeBox"
                                       Header="Disk size (MB, 0 = default)"
                                       Value="{Binding Selected.DiskSizeMb, Mode=TwoWay}"
                                       Minimum="0"
                                       Maximum="1048576"
                                       SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </Border>

                    <!-- Mapped folders -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="FoldersSection" Text="Mapped folders" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Selected.MappedFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MappedFolderItem">
                                        <Grid ColumnSpacing="8" Padding="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind HostFolder}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind AccessLabel}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Button Grid.Column="2"
                                                    x:Uid="RemoveButton"
                                                    Content="Remove"
                                                    Command="{Binding DataContext.Selected.RemoveFolderCommand, ElementName=Root}"
                                                    CommandParameter="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="NewFolderBox"
                                         PlaceholderText="C:\path\to\host\folder"
                                         Text="{Binding Selected.NewFolderHost, Mode=TwoWay}" />
                                <CheckBox Grid.Column="1"
                                          x:Uid="NewFolderReadOnly"
                                          Content="Read only"
                                          IsChecked="{Binding Selected.NewFolderReadOnly, Mode=TwoWay}" />
                                <Button Grid.Column="2"
                                        x:Uid="AddButton"
                                        Content="Add"
                                        Command="{Binding Selected.AddFolderCommand}" />
                                <Button Grid.Column="3"
                                        x:Uid="MapNowButton"
                                        Content="Map now"
                                        Command="{Binding Selected.MapNowCommand}"
                                        Visibility="{Binding Selected.CanMapAtRuntime, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Logon commands -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="LogonSection" Text="Logon commands" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Selected.LogonCommands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vo:LogonCommand">
                                        <Grid ColumnSpacing="8" Padding="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Command}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    x:Uid="RemoveButton"
                                                    Content="Remove"
                                                    Command="{Binding DataContext.Selected.RemoveLogonCommand, ElementName=Root}"
                                                    CommandParameter="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="NewLogonBox"
                                         PlaceholderText="cmd.exe /c echo hello"
                                         Text="{Binding Selected.NewLogonCommand, Mode=TwoWay}" />
                                <Button Grid.Column="1"
                                        x:Uid="AddButton"
                                        Content="Add"
                                        Command="{Binding Selected.AddLogonCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Application launch list (RemoteApp) -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="AppsSection" Text="Applications" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Uid="AppsHint"
                                       Text="Open these applications as RemoteApp windows. They are offered next to the built-in defaults and the global launch list."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <ItemsControl ItemsSource="{Binding Selected.RailApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vo:RailApp">
                                        <Grid ColumnSpacing="8" Padding="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Program}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button Grid.Column="2"
                                                    x:Uid="RemoveButton"
                                                    Content="Remove"
                                                    Command="{Binding DataContext.Selected.RemoveRailAppCommand, ElementName=Root}"
                                                    CommandParameter="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="NewRailAppNameBox"
                                         Width="96"
                                         PlaceholderText="Name"
                                         Text="{Binding Selected.NewRailAppName, Mode=TwoWay}" />
                                <TextBox Grid.Column="1"
                                         x:Uid="NewRailAppProgramBox"
                                         PlaceholderText="C:\path\to\app.exe"
                                         Text="{Binding Selected.NewRailAppProgram, Mode=TwoWay}" />
                                <TextBox Grid.Column="2"
                                         x:Uid="NewRailAppArgsBox"
                                         PlaceholderText="Arguments"
                                         Text="{Binding Selected.NewRailAppArguments, Mode=TwoWay}" />
                                <Button Grid.Column="3"
                                        x:Uid="AddButton"
                                        Content="Add"
                                        Command="{Binding Selected.AddRailAppCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Checkpoints -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="CheckpointsSection" Text="Checkpoints" Style="{StaticResource SectionTitle}" />
                            <ToggleSwitch x:Uid="CheckpointTemplateSwitch"
                                          Header="Save as template"
                                          IsOn="{Binding Selected.CheckpointAsTemplate, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="SaveCheckpointButton"
                                        Content="Save checkpoint"
                                        Command="{Binding Selected.SaveCheckpointCommand}" />
                                <Button x:Uid="RefreshCheckpointsButton"
                                        Content="Refresh"
                                        Command="{Binding Selected.RefreshCheckpointsCommand}" />
                                <Button x:Uid="RestoreCheckpointButton"
                                        Content="Restore selected"
                                        Command="{Binding Selected.RestoreCheckpointCommand}" />
                            </StackPanel>
                            <ListView Height="140"
                                      ItemsSource="{Binding Selected.Checkpoints}"
                                      SelectedItem="{Binding Selected.SelectedCheckpoint, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vo:SandboxCheckpoint">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="2">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Type}" Foreground="{StaticResource WsmAccentBrush}" />
                                            <TextBlock Text="{x:Bind CreatedUtc}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- Runtime -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="RuntimeSection" Text="Runtime" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Selected.RuntimeSummary}"
                                       FontFamily="{StaticResource WsmMonoFont}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="ExecBox"
                                         PlaceholderText="Command to run inside the sandbox"
                                         Text="{Binding Selected.ExecCommandText, Mode=TwoWay}" />
                                <Button Grid.Column="1" x:Uid="ExecButton" Content="Run" Command="{Binding Selected.ExecuteCommand}" />
                                <Button Grid.Column="2" x:Uid="RefreshIpButton" Content="Get IPs" Command="{Binding Selected.GetIpsCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Manifest -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="ManifestSection" Text="Manifest" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Selected.ManifestDisplay}"
                                       FontFamily="{StaticResource WsmMonoFont}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="ShowManifestButton"
                                        Content="Show manifest"
                                        IsEnabled="{Binding Selected.HasManifest}"
                                        Click="OnShowManifestClick" />
                                <Button x:Uid="OpenManifestFolderButton"
                                        Content="Open containing folder"
                                        IsEnabled="{Binding Selected.HasManifest}"
                                        Click="OnOpenManifestFolderClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Danger zone -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="DangerSection" Text="Danger zone" Style="{StaticResource SectionTitle}" />
                            <Button x:Uid="DeleteButton" Content="Delete sandbox" Click="OnDeleteInstanceClick" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <!-- ======================= Delete confirmation ======================= -->
        <ContentDialog x:Name="ConfirmDeleteDialog"
                       x:Uid="ConfirmDeleteDialog"
                       Title="Delete sandbox?"
                       PrimaryButtonText="Delete"
                       CloseButtonText="Cancel"
                       DefaultButton="Close">
            <TextBlock x:Uid="ConfirmDeleteBody"
                       Text="This permanently removes the sandbox definition."
                       TextWrapping="Wrap" />
        </ContentDialog>

        <!-- ======================= Add application (global list) ======================= -->
        <ContentDialog x:Name="AddAppDialog"
                       x:Uid="AddAppDialog"
                       Title="Add application"
                       PrimaryButtonText="Add"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="OnAddGlobalAppPrimary">
            <StackPanel Spacing="10" Width="420">
                <TextBox x:Uid="AddAppNameBox"
                         Header="Name"
                         PlaceholderText="My tool"
                         Text="{Binding NewGlobalAppName, Mode=TwoWay}" />
                <TextBox x:Uid="AddAppProgramBox"
                         Header="Program (path in the sandbox)"
                         PlaceholderText="C:\tools\app.exe"
                         Text="{Binding NewGlobalAppProgram, Mode=TwoWay}" />
                <TextBox x:Uid="AddAppArgumentsBox"
                         Header="Arguments (optional)"
                         Text="{Binding NewGlobalAppArguments, Mode=TwoWay}" />
                <TextBlock x:Uid="AddAppScopeHint"
                           Text="The application is added to the launch list for every sandbox. Sandbox-specific applications are managed in a sandbox's settings."
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ContentDialog>

        <!-- ======================= Create shortcut ======================= -->
        <ContentDialog x:Name="ShortcutDialog"
                       x:Uid="ShortcutDialog"
                       Title="Create shortcut"
                       PrimaryButtonText="Create"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="OnCreateShortcutPrimary">
            <StackPanel Spacing="10" Width="460">
                <ComboBox x:Name="ShortcutAppCombo"
                          x:Uid="ShortcutAppBox"
                          Header="Application"
                          HorizontalAlignment="Stretch"
                          DisplayMemberPath="DisplayName" />
                <TextBox x:Name="ShortcutNameBox"
                         x:Uid="ShortcutNameBox"
                         Header="Shortcut name" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ShortcutFolderBox"
                             x:Uid="ShortcutFolderBox"
                             Header="Folder" />
                    <Button Grid.Column="1"
                            x:Uid="ShortcutBrowseButton"
                            Content="Browse..."
                            VerticalAlignment="Bottom"
                            Click="OnBrowseShortcutFolderClick" />
                </Grid>
                <TextBlock x:Uid="ShortcutHint"
                           Text="The shortcut connects to the sandbox and opens the application as a RemoteApp window. The sandbox must be running."
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
