<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Wsm.Connection.RailClient</RootNamespace>
    <AssemblyName>Wsm.Connection.RailClient</AssemblyName>
    <Description>WDAG-style RemoteApp client: hosts the mstscax ActiveX control over the RDPBASE named pipe and presents each remote application as a free-floating top-level window.</Description>
  </PropertyGroup>

  <!-- Shared mstscax COM interop generation (TlbImp + AxImp). -->
  <Import Project="..\MstscInterop.targets" />

  <ItemGroup>
    <ProjectReference Include="..\..\00-Core\Wsm.Domain\Wsm.Domain.csproj" />
    <ProjectReference Include="..\Wsm.Connection.RdpBase\Wsm.Connection.RdpBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Volo.Abp.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wsm.Tests" />
  </ItemGroup>

</Project>
