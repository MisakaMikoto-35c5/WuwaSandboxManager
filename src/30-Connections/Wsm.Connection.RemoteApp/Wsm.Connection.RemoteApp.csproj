<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Wsm.Connection.RemoteApp</RootNamespace>
    <AssemblyName>Wsm.Connection.RemoteApp</AssemblyName>
    <Description>RemoteApp (RAIL) connection kit: generates the client .rdp document and presents the session through the stock Remote Desktop client (mstsc.exe), bridging the sandbox named pipe to loopback TCP when the guest is not reachable over TCP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\00-Core\Wsm.Domain\Wsm.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Volo.Abp.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wsm.Tests" />
  </ItemGroup>

</Project>
