<Window x:Class="Wsm.Connection.RdpHost.Wpf.RdpHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Windows Sandbox"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="480"
        Background="#101014"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        SizeChanged="OnWindowSizeChanged"
        PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel>
        <!-- Quick controls -->
        <Border x:Name="Toolbar"
                DockPanel.Dock="Top"
                Background="#1B1B20"
                BorderBrush="#2A2A32"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Margin="12,0,4,0"
                           FontSize="12"
                           Foreground="#B9B9C4" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CtrlAltDelButton" Click="OnSendCtrlAltDelClick" Margin="0,0,6,0" Padding="10,4" Content="Ctrl+Alt+Del" />
                    <Button x:Name="RestartButton" Click="OnRestartClick" Margin="0,0,6,0" Padding="10,4" Content="Restart" />
                    <Button x:Name="ShutdownButton" Click="OnShutdownClick" Margin="0,0,6,0" Padding="10,4" Content="Shut down" />
                    <Button x:Name="ForceShutdownButton" Click="OnForceShutdownClick" Margin="0,0,6,0" Padding="10,4" Content="Force shut down" />
                    <Button x:Name="PowerOnButton" Click="OnPowerOnClick" Margin="0,0,6,0" Padding="10,4" Content="Power on" />
                    <Button x:Name="FullScreenButton" Click="OnToggleFullScreenClick" Padding="10,4" Content="Full screen" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- RDP surface + disconnected overlay -->
        <Grid x:Name="Surface">
            <wfi:WindowsFormsHost x:Name="RdpHost" />
            <Border x:Name="Overlay" Background="#E618181C" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock x:Name="OverlayTitle"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="Connection disconnected" />
                    <TextBlock x:Name="OverlayBody"
                               Margin="0,8,0,0"
                               FontSize="13"
                               Foreground="#DCDCE4"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock x:Name="OverlayDetail"
                               Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="#A0A0AC"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Button x:Name="OverlayCloseButton"
                            Margin="0,18,0,0"
                            Padding="18,5"
                            HorizontalAlignment="Center"
                            Content="Close"
                            Click="OnOverlayCloseClick" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
