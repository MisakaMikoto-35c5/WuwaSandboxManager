<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Wsm.Ui.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Wsm.Ui.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Signature accent + semantic status colours (theme-agnostic mid-tones) -->
            <SolidColorBrush x:Key="WsmAccentBrush" Color="#FF2AA9E0" />
            <SolidColorBrush x:Key="WsmAccentSoftBrush" Color="#262AA9E0" />
            <SolidColorBrush x:Key="WsmAvailableBrush" Color="#FF3DD68C" />
            <SolidColorBrush x:Key="WsmReservedBrush" Color="#FFE0A93B" />
            <SolidColorBrush x:Key="WsmUnavailableBrush" Color="#FF9AA0A6" />

            <!-- Type: display for headings, mono for identifiers/runtime -->
            <FontFamily x:Key="WsmDisplayFont">Segoe UI Variable Display,Segoe UI</FontFamily>
            <FontFamily x:Key="WsmMonoFont">Cascadia Mono,Consolas,Courier New</FontFamily>

            <!-- Layout primitives -->
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource WsmDisplayFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="MetaText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <!-- Small status/type pill: pair with a background brush inline. -->
            <Style x:Key="PillBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
