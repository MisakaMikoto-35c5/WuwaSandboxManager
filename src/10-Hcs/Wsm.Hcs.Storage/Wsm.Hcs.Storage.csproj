<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Wsm.Hcs.Storage</RootNamespace>
    <AssemblyName>Wsm.Hcs.Storage</AssemblyName>
    <Description>Provisions and seeds the user-data storage for an HCS sandbox.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\00-Core\Wsm.Domain\Wsm.Domain.csproj" />
    <ProjectReference Include="..\Wsm.Hcs.Interop\Wsm.Hcs.Interop.csproj" />
    <ProjectReference Include="..\Wsm.Hcs.Layout\Wsm.Hcs.Layout.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Core" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Wsm.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Image payload for the window-mirror read side: the logon hook and the read
         side itself are baked into the base image, because a process-isolated
         container reads its registry and starts its session before any WSM code can
         run inside it. -->
    <EmbeddedResource Include="Images\wsm-winlogon-wrap.cmd" />
    <EmbeddedResource Include="Images\wsm-desktop-read.cmd" />
    <EmbeddedResource Include="Images\wsm-desktop-read.ps1" />
  </ItemGroup>

</Project>
