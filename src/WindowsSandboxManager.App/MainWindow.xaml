<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsSandboxManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WindowsSandboxManager.App.ViewModels"
    xmlns:vo="using:WindowsSandboxManager.Domain.ValueObjects">

    <Grid x:Name="Root" Padding="14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Windows Sandbox Manager" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="New sandbox" Command="{Binding CreateCommand}" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            <ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding EnvironmentSummary}" Foreground="Gray" TextWrapping="Wrap" FontSize="12" />

        <!-- Body -->
        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{Binding Instances}"
                      SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SandboxInstanceViewModel">
                        <StackPanel Padding="6,4">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ShortId}" FontSize="11" Foreground="Gray" />
                                <TextBlock Text="{x:Bind State}" FontSize="11" Foreground="SteelBlue" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Padding="0,0,10,0">
                    <TextBlock Text="Configuration" FontSize="16" FontWeight="SemiBold" />

                    <TextBox Header="Name" Text="{Binding Selected.Name, Mode=TwoWay}" />
                    <NumberBox Header="Memory (MB)" Value="{Binding Selected.MemoryMb, Mode=TwoWay}"
                               Minimum="2048" Maximum="262144" SpinButtonPlacementMode="Compact" />
                    <NumberBox Header="CPU cores (honoured by the HCS backend only)"
                               Value="{Binding Selected.CpuCores, Mode=TwoWay}"
                               Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact" />
                    <ComboBox Header="Networking" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Selected.NetworkingOptions}"
                              SelectedItem="{Binding Selected.Networking, Mode=TwoWay}" />
                    <ComboBox Header="Virtual GPU" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Selected.VgpuOptions}"
                              SelectedItem="{Binding Selected.VirtualGpu, Mode=TwoWay}" />
                    <ToggleSwitch Header="RemoteApp (RAIL) mode" IsOn="{Binding Selected.RailMode, Mode=TwoWay}" />
                    <ToggleSwitch Header="Full screen" IsOn="{Binding Selected.FullScreen, Mode=TwoWay}" />
                    <ToggleSwitch Header="Protected client" IsOn="{Binding Selected.ProtectedClient, Mode=TwoWay}" />

                    <TextBlock Text="Storage (HCS backend)" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox Header="User-data location" PlaceholderText="(default) C:\ProgramData\Microsoft\Windows\Containers\ContainerStorages\&lt;id&gt;"
                             Text="{Binding Selected.StoragePath, Mode=TwoWay}" />
                    <NumberBox Header="Disk size (MB, 0 = default)" Value="{Binding Selected.DiskSizeMb, Mode=TwoWay}"
                               Minimum="0" Maximum="1048576" SpinButtonPlacementMode="Compact" />

                    <TextBlock Text="Mapped folders" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding Selected.MappedFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vo:MappedFolder">
                                <Grid ColumnSpacing="8" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind HostFolder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ReadOnly}" VerticalAlignment="Center" Foreground="Gray" />
                                    <Button Grid.Column="2" Content="Remove"
                                            Command="{Binding DataContext.Selected.RemoveFolderCommand, ElementName=Root}"
                                            CommandParameter="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" PlaceholderText="C:\path\to\host\folder"
                                 Text="{Binding Selected.NewFolderHost, Mode=TwoWay}" />
                        <CheckBox Grid.Column="1" Content="Read only" IsChecked="{Binding Selected.NewFolderReadOnly, Mode=TwoWay}" />
                        <Button Grid.Column="2" Content="Add" Command="{Binding Selected.AddFolderCommand}" />
                    </Grid>

                    <TextBlock Text="Logon commands" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding Selected.LogonCommands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vo:LogonCommand">
                                <Grid ColumnSpacing="8" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Command}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Remove"
                                            Command="{Binding DataContext.Selected.RemoveLogonCommand, ElementName=Root}"
                                            CommandParameter="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" PlaceholderText="cmd.exe /c echo hello"
                                 Text="{Binding Selected.NewLogonCommand, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Add" Command="{Binding Selected.AddLogonCommand}" />
                    </Grid>

                    <TextBlock Text="Actions" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save" Command="{Binding Selected.SaveCommand}" />
                        <Button Content="Start (Desktop)" Command="{Binding Selected.StartDesktopCommand}" />
                        <Button Content="Start (RemoteApp)" Command="{Binding Selected.StartRemoteAppCommand}" />
                        <Button Content="Stop" Command="{Binding Selected.StopCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Connect (Desktop)" Command="{Binding Selected.ConnectDesktopCommand}" />
                        <Button Content="Connect (RemoteApp)" Command="{Binding Selected.ConnectRemoteAppCommand}" />
                        <Button Content="Delete" Command="{Binding Selected.DeleteCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Selected.RuntimeSummary}" FontFamily="Consolas" FontSize="12"
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Selected.Status}" Foreground="DarkOrange" TextWrapping="Wrap" />

                    <TextBlock Text="Checkpoints (HCS backend)" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch Header="As template" IsOn="{Binding Selected.CheckpointAsTemplate, Mode=TwoWay}" />
                        <Button Content="Save checkpoint" Command="{Binding Selected.SaveCheckpointCommand}" />
                        <Button Content="Refresh" Command="{Binding Selected.RefreshCheckpointsCommand}" />
                        <Button Content="Restore selected" Command="{Binding Selected.RestoreCheckpointCommand}" />
                    </StackPanel>
                    <ListView Height="130" ItemsSource="{Binding Selected.Checkpoints}"
                              SelectedItem="{Binding Selected.SelectedCheckpoint, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vo:SandboxCheckpoint">
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Type}" Foreground="SteelBlue" />
                                    <TextBlock Text="{x:Bind CreatedUtc}" Foreground="Gray" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8,6" CornerRadius="4">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" />
        </Border>
    </Grid>
</Window>
