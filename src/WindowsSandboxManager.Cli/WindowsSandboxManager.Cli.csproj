<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WindowsSandboxManager.Cli</RootNamespace>
    <AssemblyName>wsm</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Command line interface for the Windows Sandbox Manager engine.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsSandboxManager.Application\WindowsSandboxManager.Application.csproj" />
    <ProjectReference Include="..\WindowsSandboxManager.Infrastructure\WindowsSandboxManager.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
